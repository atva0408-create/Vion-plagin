{
  "version": 2,
  "name": "Camera gone — to Telegram",
  "description": "Writes to Telegram when a camera stops responding; when Telegram did not take it, to the phone.",
  "suppressDuplicates": true,
  "nodes": [
    {
      "id": "trigger",
      "type": "trigger-system",
      "position": {
        "x": 320,
        "y": 192
      },
      "data": {
        "type": "trigger-system",
        "category": "camera",
        "eventType": "camera:disconnected",
        "targetId": ""
      }
    },
    {
      "id": "notify",
      "type": "action-notification",
      "position": {
        "x": 320,
        "y": 416
      },
      "data": {
        "type": "action-notification",
        "title": "Camera not responding: {{system.cameraName}}",
        "body": "Check the power and the network of the camera.",
        "severity": "warn",
        "deepLink": "",
        "targets": [],
        "route": {
          "channels": [
            "telegram"
          ],
          "fallback": [
            "phone"
          ]
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e-trigger-out-notify",
      "source": "trigger",
      "target": "notify"
    }
  ]
}
