{
  "version": 2,
  "name": "Tägliches Bild",
  "description": "Sendet jeden Tag um 09:00 Uhr ein Bild der Kamera. Die Uhrzeit ändern Sie im Zeitplan.",
  "inputs": [
    {
      "key": "camera",
      "type": "camera",
      "label": "Kamera"
    }
  ],
  "nodes": [
    {
      "id": "trigger",
      "type": "trigger-schedule",
      "position": {
        "x": 320,
        "y": 192
      },
      "data": {
        "type": "trigger-schedule",
        "cron": "0 9 * * *"
      }
    },
    {
      "id": "snapshot",
      "type": "action-snapshot",
      "position": {
        "x": 320,
        "y": 416
      },
      "data": {
        "type": "action-snapshot",
        "cameraId": "{{input:camera}}",
        "forceNew": true
      }
    },
    {
      "id": "notify",
      "type": "action-notification",
      "position": {
        "x": 320,
        "y": 640
      },
      "data": {
        "type": "action-notification",
        "title": "Tägliches Bild",
        "body": "Das sieht die Kamera gerade.",
        "severity": "info",
        "deepLink": "",
        "targets": [],
        "image": "{{snapshot.base64}}"
      }
    }
  ],
  "edges": [
    {
      "id": "e-trigger-out-snapshot",
      "source": "trigger",
      "target": "snapshot"
    },
    {
      "id": "e-snapshot-out-notify",
      "source": "snapshot",
      "target": "notify"
    }
  ]
}
