{
  "version": 2,
  "name": "Kamera weg — an Telegram",
  "description": "Schreibt an Telegram, wenn eine Kamera nicht mehr antwortet; nahm Telegram es nicht an, aufs Telefon.",
  "suppressDuplicates": true,
  "nodes": [
    {
      "id": "trigger",
      "type": "trigger-system",
      "position": {
        "x": 320,
        "y": 192
      },
      "data": {
        "type": "trigger-system",
        "category": "camera",
        "eventType": "camera:disconnected",
        "targetId": ""
      }
    },
    {
      "id": "notify",
      "type": "action-notification",
      "position": {
        "x": 320,
        "y": 416
      },
      "data": {
        "type": "action-notification",
        "title": "Kamera antwortet nicht: {{system.cameraName}}",
        "body": "Prüfen Sie Strom und Netzwerk der Kamera.",
        "severity": "warn",
        "deepLink": "",
        "targets": [],
        "route": {
          "channels": [
            "telegram"
          ],
          "fallback": [
            "phone"
          ]
        }
      }
    }
  ],
  "edges": [
    {
      "id": "e-trigger-out-notify",
      "source": "trigger",
      "target": "notify"
    }
  ]
}
