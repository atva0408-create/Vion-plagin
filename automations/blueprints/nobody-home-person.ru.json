{
  "version": 2,
  "name": "Человек, пока никого нет дома",
  "description": "Присылает на телефон срочное уведомление со снимком, когда камера видит человека, а дома никого нет (по телефонам или как задано вручную); если не дошло — в Telegram.",
  "inputs": [
    {
      "key": "camera",
      "type": "camera",
      "label": "Камера"
    }
  ],
  "suppressDuplicates": true,
  "nodes": [
    {
      "id": "trigger",
      "type": "trigger-detection",
      "position": {
        "x": 320,
        "y": 192
      },
      "data": {
        "type": "trigger-detection",
        "cameraId": "{{input:camera}}",
        "eventPhase": [
          "segment-start"
        ],
        "detectionLabels": [
          "person"
        ],
        "confidenceThreshold": 0,
        "audioLabels": [],
        "faceFilter": [],
        "licensePlateFilter": []
      }
    },
    {
      "id": "away",
      "type": "condition-home",
      "position": {
        "x": 320,
        "y": 416
      },
      "data": {
        "type": "condition-home",
        "expect": "away"
      }
    },
    {
      "id": "snapshot",
      "type": "action-snapshot",
      "position": {
        "x": 320,
        "y": 640
      },
      "data": {
        "type": "action-snapshot",
        "cameraId": "{{input:camera}}",
        "forceNew": true
      }
    },
    {
      "id": "notify",
      "type": "action-notification",
      "position": {
        "x": 320,
        "y": 864
      },
      "data": {
        "type": "action-notification",
        "title": "Пока никого нет: человек у {{event.cameraName}}",
        "body": "Дома никого нет, а камера видит человека.",
        "severity": "critical",
        "deepLink": "",
        "targets": [],
        "route": {
          "channels": [
            "phone"
          ],
          "fallback": [
            "telegram"
          ]
        },
        "image": "{{snapshot.base64}}"
      }
    }
  ],
  "edges": [
    {
      "id": "e-trigger-out-away",
      "source": "trigger",
      "target": "away"
    },
    {
      "id": "e-away-true-snapshot",
      "source": "away",
      "target": "snapshot",
      "sourceHandle": "true"
    },
    {
      "id": "e-snapshot-out-notify",
      "source": "snapshot",
      "target": "notify"
    }
  ]
}
