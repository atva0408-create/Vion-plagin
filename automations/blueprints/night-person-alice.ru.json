{
  "version": 2,
  "name": "Человек ночью — Алиса и телефон",
  "description": "Срочно говорит на станциях Алисы и присылает на телефон снимок, когда камера видит человека с 22:00 до 06:00; если ни туда, ни туда не дошло — в Telegram. Срочное проходит и в тихие часы, если канал ночью не молчит.",
  "inputs": [
    {
      "key": "camera",
      "type": "camera",
      "label": "Камера"
    }
  ],
  "suppressDuplicates": true,
  "nodes": [
    {
      "id": "trigger",
      "type": "trigger-detection",
      "position": {
        "x": 320,
        "y": 192
      },
      "data": {
        "type": "trigger-detection",
        "cameraId": "{{input:camera}}",
        "eventPhase": [
          "segment-start"
        ],
        "detectionLabels": [
          "person"
        ],
        "confidenceThreshold": 0,
        "audioLabels": [],
        "faceFilter": [],
        "licensePlateFilter": []
      }
    },
    {
      "id": "night",
      "type": "condition-time",
      "position": {
        "x": 320,
        "y": 416
      },
      "data": {
        "type": "condition-time",
        "startTime": "22:00",
        "endTime": "06:00",
        "days": []
      }
    },
    {
      "id": "snapshot",
      "type": "action-snapshot",
      "position": {
        "x": 320,
        "y": 640
      },
      "data": {
        "type": "action-snapshot",
        "cameraId": "{{input:camera}}",
        "forceNew": true
      }
    },
    {
      "id": "notify",
      "type": "action-notification",
      "position": {
        "x": 320,
        "y": 864
      },
      "data": {
        "type": "action-notification",
        "title": "Человек ночью: {{event.cameraName}}",
        "body": "Камера видит человека.",
        "severity": "critical",
        "deepLink": "",
        "targets": [],
        "route": {
          "channels": [
            "station",
            "phone"
          ],
          "fallback": [
            "telegram"
          ]
        },
        "image": "{{snapshot.base64}}"
      }
    }
  ],
  "edges": [
    {
      "id": "e-trigger-out-night",
      "source": "trigger",
      "target": "night"
    },
    {
      "id": "e-night-true-snapshot",
      "source": "night",
      "target": "snapshot",
      "sourceHandle": "true"
    },
    {
      "id": "e-snapshot-out-notify",
      "source": "snapshot",
      "target": "notify"
    }
  ]
}
